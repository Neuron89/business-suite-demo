# =============================================================================
# Acme Industries Business Suite — Demo (self-hosted on your own domain)
#
# Copy to `.env` and adjust. Defaults for everything except the domain and the
# tunnel token are baked into docker-compose.yml.
#
# For a localhost-only run you do not need this file at all: use `local.env`
# (docker compose --env-file local.env up -d --build).
# =============================================================================

# Public base domain. The portal is served at the apex and each app at
# <sub>.${DEMO_DOMAIN}. Needs DNS for the apex plus a wildcard (*.DEMO_DOMAIN).
DEMO_DOMAIN=demo.example.com

# Scheme and optional ":port" suffix used when the portal builds browser-facing
# URLs for SSO redirects. Leave as-is behind a TLS-terminating proxy/tunnel.
DEMO_SCHEME=https
DEMO_PORT_SUFFIX=

# Host port the Caddy proxy listens on (the tunnel and local smoke tests hit this).
HTTP_PORT=8080

# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels). Required only for
# the `--profile tunnel` (public) run. Point both public hostnames at Caddy:
#   demo.example.com      -> http://caddy:80
#   *.demo.example.com    -> http://caddy:80
CLOUDFLARE_TUNNEL_TOKEN=

# Shared secret the portal uses to sign cross-app SSO tokens (every app verifies
# with the same value). Change it for any public deployment.
PORTAL_SSO_SECRET=change-me

# Per-app JWT secrets (optional; demo defaults exist in docker-compose.yml).
JWT_SECRET=change-me-portal
JWT_SECRET_MOC=change-me-moc
JWT_REFRESH_SECRET_MOC=change-me-moc-refresh
JWT_SECRET_IT=change-me-it
JWT_REFRESH_SECRET_IT=change-me-it-refresh
JWT_SECRET_SHIPPING=change-me-shipping
JWT_REFRESH_SECRET_SHIPPING=change-me-shipping-refresh
JWT_SECRET_COMPLAINT=change-me-complaint
JWT_REFRESH_SECRET_COMPLAINT=change-me-complaint-refresh
JWT_SECRET_ONBOARDING=change-me-onboarding
JWT_REFRESH_SECRET_ONBOARDING=change-me-onboarding-refresh

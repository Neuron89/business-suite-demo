# =============================================================================
# Acme Industries Business Suite — localhost mode
#
#   docker compose --env-file local.env up -d --build
#   (or: bash install.sh --local)
#
# Serves the suite at http://localhost:8080 with one *.localhost subdomain per
# app (http://moc.localhost:8080, http://it.localhost:8080, ...). Chrome, Edge
# and Firefox resolve *.localhost to 127.0.0.1 without any hosts-file changes.
# No domain, DNS or Cloudflare tunnel is needed.
#
# If you change HTTP_PORT, change DEMO_PORT_SUFFIX to match.
# =============================================================================

DEMO_DOMAIN=localhost
DEMO_SCHEME=http
HTTP_PORT=8080
DEMO_PORT_SUFFIX=:8080

PORTAL_SSO_SECRET=demo-sso-shared-secret
